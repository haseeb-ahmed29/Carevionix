@model IReadOnlyList<Appointment>

<div class="table-responsive">
    <table class="table align-middle admin-appointments-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Type</th>
                <th>Status</th>
                <th>Approval</th>
                <th>Invoice</th>
                <th>Payment</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var appointment in Model)
        {
            var invoice = appointment.Invoice;
            var canApprove = appointment.Status is AppointmentStatus.Pending or AppointmentStatus.Rescheduled;
            var canReject = appointment.Status is AppointmentStatus.Pending or AppointmentStatus.Accepted or AppointmentStatus.Rescheduled;
            var canInvoice = appointment.Status == AppointmentStatus.Completed && invoice is null;
            <tr>
                <td>@appointment.ScheduledAt.ToString("g")</td>
                <td><span class="avatar-pill"><img src="@(appointment.Patient?.User?.ProfileImagePath ?? Url.Content("~/Images/Petient Penal Hero Image.jpg"))" alt="" /><span>@(!string.IsNullOrWhiteSpace(appointment.PatientName) ? appointment.PatientName : appointment.Patient?.User?.FullName)</span></span></td>
                <td><span class="avatar-pill"><img src="@(appointment.Doctor?.User?.ProfileImagePath ?? Url.Content("~/Images/Home Page hero image.jpg"))" alt="" /><span>@(!string.IsNullOrWhiteSpace(appointment.DoctorName) ? appointment.DoctorName : appointment.Doctor?.User?.FullName)</span></span></td>
                <td>@appointment.ConsultationType</td>
                <td><span class="badge badge-soft">@appointment.Status</span></td>
                <td>
                    <div class="admin-action-row">
                        @if (canApprove)
                        {
                            <form asp-action="UpdateAppointmentStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@appointment.Id" />
                                <input type="hidden" name="status" value="@AppointmentStatus.Accepted" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Approve</button>
                            </form>
                        }
                        @if (canReject)
                        {
                            <form asp-action="UpdateAppointmentStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@appointment.Id" />
                                <input type="hidden" name="status" value="@AppointmentStatus.Rejected" />
                                <button class="btn btn-sm btn-outline-dark" type="submit">Reject</button>
                            </form>
                        }
                        @if (!canApprove && !canReject)
                        {
                            <span class="text-muted">No action</span>
                        }
                    </div>
                </td>
                <td>
                    @if (invoice is not null)
                    {
                        <div class="invoice-summary">
                            <strong>PKR @invoice.Total.ToString("N2")</strong>
                            <span>Generated @invoice.GeneratedAt.ToLocalTime().ToString("g")</span>
                        </div>
                    }
                    else if (canInvoice)
                    {
                        <form asp-action="GenerateInvoice" method="post" class="admin-invoice-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="AppointmentId" value="@appointment.Id" />
                            <input class="form-control form-control-sm" name="InsuranceAmount" type="number" step="0.01" min="0" placeholder="Insurance" />
                            <input class="form-control form-control-sm" name="Discount" type="number" step="0.01" min="0" placeholder="Discount" />
                            <button class="btn btn-sm btn-primary" type="submit">Generate</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">After completion</span>
                    }
                </td>
                <td>
                    @if (invoice is null)
                    {
                        <span class="text-muted">No invoice</span>
                    }
                    else if (invoice.PaymentStatus == PaymentStatus.Submitted)
                    {
                        <div class="invoice-summary mb-2">
                            <strong>@invoice.DemoPayerName</strong>
                            <span>@invoice.DemoPaymentMethod</span>
                            <span>@invoice.DemoPaymentReceipt</span>
                        </div>
                        <form asp-action="ApproveInvoicePayment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="InvoiceId" value="@invoice.Id" />
                            <button class="btn btn-sm btn-primary" type="submit">Approve payment</button>
                        </form>
                    }
                    else if (invoice.PaymentStatus == PaymentStatus.Approved)
                    {
                        <span class="status-badge is-active">Payment received</span>
                    }
                    else if (invoice.Total <= 0)
                    {
                        <span class="badge-soft">Settled</span>
                    }
                    else
                    {
                        <span class="badge-warn">Waiting payment</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state">No appointments in this section.</div>
    }
</div>
