@model IReadOnlyList<HealthRecord>
@{
    ViewData["Title"] = "Health Records";
}

<section class="table-card">
    <div class="p-3 border-bottom"><h1 class="h4 mb-0">Health records</h1></div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Name</th><th>Patient Name</th><th>Title</th><th>Type</th><th>File</th><th>Uploaded</th><th></th></tr></thead>
            <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td><span class="avatar-pill"><img src="@(record.Patient?.User?.ProfileImagePath ?? Url.Content("~/Images/Petient Penal Hero Image.jpg"))" alt="" /><span>@record.Patient?.User?.FullName</span></span></td>
                    <td>@record.Patient?.User?.FullName</td>
                    <td>@record.Title</td>
                    <td>@record.RecordType</td>
                    <td>@record.FileName<br /><span class="text-muted-strong small">@Math.Round(record.FileSize / 1024m, 1) KB</span></td>
                    <td>@record.UploadedAt.ToLocalTime().ToString("g")</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="DownloadHealthRecord" asp-route-id="@record.Id">View / Download</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
