@model ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-panel">
    <h1 class="page-title h3 mb-3">Reset password</h1>
    <form asp-action="ForgotPassword" method="post" class="vstack gap-3">
        @Html.AntiForgeryToken()
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" />
        <button class="btn btn-primary" type="submit">Send New Password</button>
    </form>
</section>
