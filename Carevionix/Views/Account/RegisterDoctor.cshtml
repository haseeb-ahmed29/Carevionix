@model RegisterDoctorDto
@{
    ViewData["Title"] = "Doctor Registration";
}

<section class="auth-panel doctor-auth">
    <div class="eyebrow mb-2">Doctor account</div>
    <h1 class="page-title h3 mb-3">Doctor accounts are admin-managed</h1>
    <p class="text-muted-strong mb-4">Only an admin can add, update, activate, deactivate, or remove doctors.</p>
    <a class="btn btn-primary" asp-controller="Account" asp-action="AdminLogin">Login as admin</a>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
