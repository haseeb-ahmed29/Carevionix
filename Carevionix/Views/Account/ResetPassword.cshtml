@model ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
}

<section class="auth-panel">
    <h1 class="page-title h3 mb-3">Set new password</h1>
    <form asp-action="ResetPassword" method="post" class="vstack gap-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Email" class="form-control" placeholder="Email" />
        <input asp-for="Token" class="form-control" placeholder="Reset token" />
        <input asp-for="NewPassword" class="form-control" type="password" placeholder="New password" />
        <button class="btn btn-primary" type="submit">Reset Password</button>
    </form>
</section>
