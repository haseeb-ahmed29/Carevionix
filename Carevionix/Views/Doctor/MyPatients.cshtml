@model IReadOnlyList<Patient>
@{
    ViewData["Title"] = "My Patients";
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
            <div class="eyebrow mb-2">Patient panel</div>
            <h1 class="page-title h3 mb-1">My patients</h1>
            <p class="text-muted-strong mb-0">Patients connected through your consultation history.</p>
        </div>
        <a class="btn btn-outline-primary" asp-action="Appointments">Back to appointments</a>
    </div>
</section>

<section class="table-card">
    <div class="table-card-header"><h2>Patient directory</h2></div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Name</th><th>Patient Name</th><th>Email</th><th>Phone</th><th>Insurance</th></tr></thead>
            <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td><span class="avatar-pill"><img src="@(patient.User.ProfileImagePath ?? Url.Content("~/Images/Petient Penal Hero Image.jpg"))" alt="" /><span>@patient.User.FullName</span></span></td>
                    <td>@patient.User.FullName</td>
                    <td>@patient.User.Email</td>
                    <td>@patient.User.PhoneNumber</td>
                    <td>@patient.InsuranceInfo</td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">No patients yet.</div>
        }
    </div>
</section>
