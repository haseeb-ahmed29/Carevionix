@model DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
    var pending = Model.Appointments.Count(a => a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Rescheduled);
    var completed = Model.Appointments.Count(a => a.Status == AppointmentStatus.Completed);
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
            <div class="eyebrow mb-2">Doctor workspace</div>
            <h1 class="page-title h3 mb-1">Clinical management dashboard</h1>
            <p class="text-muted-strong mb-0">Manage appointments, patients, prescriptions, and schedule from one clean workspace.</p>
        </div>
        <div class="dashboard-tabs" role="tablist" aria-label="Doctor dashboard tabs">
            <a class="tab-link active" asp-action="Dashboard">Overview</a>
            <a class="tab-link" asp-action="Appointments">Appointments</a>
            <a class="tab-link" asp-action="SharedRecords">Records</a>
            <a class="tab-link" asp-action="Availability">Manage Availability</a>
        </div>
    </div>
</section>

<section class="doctor-dashboard-grid mb-4">
    <article class="profile-card doctor-profile-card">
        <div class="doctor-avatar">
            <img src="@(Model.Doctor.User.ProfileImagePath ?? Url.Content("~/Images/Home Page hero image.jpg"))" alt="Doctor profile" />
        </div>
        <div>
            <div class="eyebrow mb-2">Doctor profile</div>
            <h2 class="page-title mb-2">Dr. @Model.Doctor.User.FullName</h2>
            <p class="doctor-profile-subtitle mb-0">@Model.Doctor.Specialty</p>
            <div class="profile-meta">
                <span class="status-badge">@Model.Doctor.ExperienceYears years experience</span>
                <span class="status-badge">PKR @Model.Doctor.ConsultationFee.ToString("N2") fee</span>
                <span class="status-badge">@Model.Doctor.Availabilities.Count available slot(s)</span>
                <span class="status-badge @(Model.Doctor.IsActive ? "is-active" : "is-pending")">@(Model.Doctor.IsActive ? "Verified" : "Pending verification")</span>
                <span class="status-badge @(Model.Doctor.IsActive ? "is-active" : "is-pending")">@(Model.Doctor.IsActive ? "Available" : "Unavailable")</span>
            </div>
        </div>
    </article>

    <section class="doctor-stat-row">
        <div class="stat-tile"><div class="text-muted-strong">Appointments</div><div class="stat-value">@Model.Appointments.Count</div></div>
        <div class="stat-tile"><div class="text-muted-strong">Pending</div><div class="stat-value">@pending</div></div>
        <div class="stat-tile"><div class="text-muted-strong">Completed</div><div class="stat-value">@completed</div></div>
    </section>
</section>

<section class="table-card">
    <div class="table-card-header">
        <div>
            <h2>Upcoming appointments</h2>
            <p class="text-muted-strong mb-0">Review consultation requests and patient sessions.</p>
        </div>
        <a class="btn btn-outline-primary" asp-action="Appointments">View all</a>
    </div>
    <partial name="_DoctorAppointmentsTable" model="Model.Appointments" />
</section>
