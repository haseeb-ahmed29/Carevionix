@model IReadOnlyList<Appointment>
@{
    ViewData["Title"] = "Doctor Appointments";
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
            <div class="eyebrow mb-2">Doctor workspace</div>
            <h1 class="page-title h3 mb-1">Appointments</h1>
            <p class="text-muted-strong mb-0">Accept, reject, complete consultations, or create prescriptions.</p>
        </div>
        <div class="dashboard-tabs" role="tablist" aria-label="Doctor dashboard tabs">
            <a class="tab-link" asp-action="Dashboard">Overview</a>
            <a class="tab-link active" asp-action="Appointments">Appointments</a>
            <a class="tab-link" asp-action="Availability">Manage Availability</a>
        </div>
    </div>
</section>

<section class="table-card">
    <div class="table-card-header">
        <h2>Appointment queue</h2>
    </div>
    <partial name="_DoctorAppointmentsTable" model="Model" />
</section>
