@model IReadOnlyList<Appointment>
@{
    ViewData["Title"] = "Video Calls";
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
            <div class="eyebrow mb-2">Virtual care</div>
            <h1 class="page-title h3 mb-1">Video calls</h1>
            <p class="text-muted-strong mb-0">Join your booked consultations from one place.</p>
        </div>
        <a class="btn btn-primary" asp-action="BookAppointment">Book Appointment</a>
    </div>
</section>

<section class="table-card">
    <div class="table-card-header">
        <h2>Consultation rooms</h2>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Date</th><th>Doctor</th><th>Type</th><th>Status</th><th>Reason</th><th></th></tr></thead>
            <tbody>
            @foreach (var appointment in Model)
            {
                var canJoin = appointment.Status == AppointmentStatus.Accepted && appointment.ConsultationType == ConsultationType.Video;
                <tr>
                    <td>@appointment.ScheduledAt.ToString("g")</td>
                    <td>@appointment.Doctor?.User?.FullName</td>
                    <td>@appointment.ConsultationType</td>
                    <td><span class="badge badge-soft">@appointment.Status</span></td>
                    <td>@appointment.Reason</td>
                    <td class="text-end">
                        @if (canJoin)
                        {
                            <form asp-controller="Patient" asp-action="VideoConsultation" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="appointmentId" value="@appointment.Id" />
                                <button class="btn btn-sm btn-primary" type="submit">Join Room</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted-strong small">Available after doctor accepts</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">No consultations booked yet. Book an appointment to start a video call.</div>
        }
    </div>
</section>
