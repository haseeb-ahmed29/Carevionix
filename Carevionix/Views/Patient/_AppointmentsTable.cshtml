@model IReadOnlyList<Appointment>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Date</th><th>Name</th><th>Doctor Name</th><th>Type</th><th>Status</th><th>Reason</th><th></th></tr></thead>
        <tbody>
        @foreach (var appointment in Model)
        {
            var canOpenRoom = appointment.Status == AppointmentStatus.Accepted && appointment.ConsultationType is ConsultationType.Video or ConsultationType.Audio;
            var canChat = appointment.Status == AppointmentStatus.Accepted && appointment.ConsultationType == ConsultationType.Chat;
            <tr>
                <td>@appointment.ScheduledAt.ToString("g")</td>
                <td>
                    <span class="avatar-pill">
                        <img src="@(appointment.Doctor?.User?.ProfileImagePath ?? Url.Content("~/Images/Home Page hero image.jpg"))" alt="" />
                        <span>@(appointment.DoctorName.Length > 0 ? appointment.DoctorName : appointment.Doctor?.User?.FullName)</span>
                    </span>
                </td>
                <td>@(appointment.DoctorName.Length > 0 ? appointment.DoctorName : appointment.Doctor?.User?.FullName)</td>
                <td>@appointment.ConsultationType</td>
                <td><span class="badge badge-soft">@appointment.Status</span></td>
                <td>@appointment.Reason</td>
                <td class="text-end">
                    @if (appointment.Status == AppointmentStatus.Completed)
                    {
                        <details class="d-inline-block text-start me-1">
                            <summary class="btn btn-sm btn-outline-primary">Review</summary>
                            <form asp-controller="Patient" asp-action="RateDoctor" method="post" class="p-2 border rounded bg-white" style="min-width: 260px">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AppointmentId" value="@appointment.Id" />
                                <select name="Rating" class="form-select form-select-sm mb-2">
                                    <option value="5">5 - Excellent</option>
                                    <option value="4">4 - Good</option>
                                    <option value="3">3 - Average</option>
                                    <option value="2">2 - Poor</option>
                                    <option value="1">1 - Bad</option>
                                </select>
                                <input name="ReviewText" class="form-control form-control-sm mb-2" placeholder="Review" />
                                <button class="btn btn-sm btn-primary" type="submit">Save</button>
                            </form>
                        </details>
                    }
                    <form asp-controller="Patient" asp-action="CancelAppointment" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AppointmentId" value="@appointment.Id" />
                        <button class="btn btn-sm btn-outline-dark" type="submit">Cancel</button>
                    </form>
                    @if (canChat && appointment.Doctor?.UserId is not null)
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Patient" asp-action="Chat" asp-route-doctorUserId="@appointment.Doctor.UserId">Open Chat</a>
                    }
                    @if (canOpenRoom)
                    {
                        <form asp-controller="Patient" asp-action="VideoConsultation" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@appointment.Id" />
                            <button class="btn btn-sm btn-primary" type="submit">@(appointment.ConsultationType == ConsultationType.Audio ? "Join Audio" : "Join Room")</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state">No appointments yet.</div>
    }
</div>
