@model AiDiagnosisViewModel
@{
    ViewData["Title"] = "AI Diagnosis";
}

<section class="section-panel has-medical-art mb-4">
    <h1 class="page-title h3 mb-3">Preliminary AI health check</h1>
    <form asp-action="AiDiagnosis" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-12">
            <label class="form-label" asp-for="Request.Symptoms">Symptoms</label>
            <textarea asp-for="Request.Symptoms" name="Symptoms" class="form-control" rows="4" placeholder="Fever, cough, headache..."></textarea>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Request.DurationDays">Duration days</label>
            <input asp-for="Request.DurationDays" name="DurationDays" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Request.ExistingConditions">Existing conditions</label>
            <input asp-for="Request.ExistingConditions" name="ExistingConditions" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Request.CurrentMedications">Current medications</label>
            <input asp-for="Request.CurrentMedications" name="CurrentMedications" class="form-control" />
        </div>
        <div class="col-12"><button class="btn btn-primary" type="submit">Analyze</button></div>
    </form>
</section>

@if (Model.Result is not null)
{
    <section class="table-card p-4">
        <h2 class="h5 mb-3">@Model.Result.PossibleCondition</h2>
        <p><strong>Urgency:</strong> @Model.Result.Urgency</p>
        <p>@Model.Result.Summary</p>
        <ul>
            @foreach (var item in Model.Result.Recommendations)
            {
                <li>@item</li>
            }
        </ul>
        <div class="alert alert-warning mb-0">@Model.Result.Disclaimer</div>
    </section>
}
